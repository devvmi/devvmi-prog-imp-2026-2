import java.util.Scanner;

public class Main {

    public static final int TAM_CONTAS = 50;
    public static final int TAM_OP = 1000;
    public static Scanner sc = new Scanner(System.in);

    public static class Conta {
        int id;
        String cliente;
        double saldo;
        double limite;
    }

    public static class Operacao {
        int id;
        int idConta;
        char tipo;
        double valor;
    }

    public static int buscaId(Conta[] v, int tam, int x) {
        for (int i = 0; i < tam; i += 1) {
            if (v[i].id == x) {
                return i;
            }
        }
        return -1;
    }

    public static double lerValorNaoNegativo(String prompt) {
        System.out.print(prompt);
        double valor = sc.nextDouble();
        while (valor < 0) {
            System.out.print("Valor invalido! " + prompt);
            valor = sc.nextDouble();
        }
        return valor;
    }

    public static int cadastrarConta(Conta[] v, int tam) {
        if (tam >= TAM_CONTAS) {
            System.out.println("Vetor cheio!");
            return tam;
        }

        v[tam] = new Conta();

        System.out.print("ID: ");
        int idDigitado = sc.nextInt();
        while (buscaId(v, tam, idDigitado) != -1) {
            System.out.print("ID ja existe! ID: ");
            idDigitado = sc.nextInt();
        }
        v[tam].id = idDigitado;
        sc.nextLine();

        System.out.print("Cliente: ");
        v[tam].cliente = sc.nextLine();

        v[tam].saldo = lerValorNaoNegativo("Saldo: ");
        v[tam].limite = lerValorNaoNegativo("Limite: ");
        sc.nextLine();

        return tam + 1;
    }

    public static int buscaBinariaCliente(Conta[] v, int tam, String x) {
        int inicio = 0;
        int fim = tam - 1;
        int meio;

        while (inicio <= fim) {
            meio = (inicio + fim) / 2;
            int comp = v[meio].cliente.compareToIgnoreCase(x);

            if (comp == 0) {
                return meio;
            } else if (comp < 0) {
                inicio = meio + 1;
            } else {
                fim = meio - 1;
            }
        }

        return -1;
    }

    public static int insertionSortCliente(Conta[] v, int tam) {
        Conta chave;
        int j;

        for (int i = 1; i < tam; i += 1) {
            chave = v[i];
            j = i - 1;

            while (j >= 0 && v[j].cliente.compareToIgnoreCase(chave.cliente) > 0) {
                v[j + 1] = v[j];
                j -= 1;
            }

            v[j + 1] = chave;
        }

        return tam;
    }

    public static int filtraOperacoes(Operacao[] vOp, int tamOp, Operacao[] vOpFiltrado, int x) {
        int k = 0;

        for (int i = 0; i < tamOp; i += 1) {
            if (vOp[i].idConta == x) {
                vOpFiltrado[k] = vOp[i];
                k += 1;
            }
        }

        return k;
    }

    public static String nomeOperacao(char tipo) {
        if (tipo == 'D' || tipo == 'd') {
            return "Deposito";
        } else if (tipo == 'S' || tipo == 's') {
            return "Saque";
        } else {
            return "Transferencia";
        }
    }

    public static String formatarValorCD(double valor) {
        if (valor >= 0) {
            return valor + "C";
        } else {
            return (-valor) + "D";
        }
    }

    public static void extrato(Conta[] vContas, int tamConta, Operacao[] vOp, int tamOp) {
        System.out.print("ID da conta: ");
        int idConta = sc.nextInt();

        int posConta = buscaId(vContas, tamConta, idConta);
        if (posConta == -1) {
            System.out.println("Conta nao encontrada!");
            return;
        }

        Operacao[] vOpFiltrado = new Operacao[TAM_OP];
        int qtdOps = filtraOperacoes(vOp, tamOp, vOpFiltrado, idConta);

        int inicioUltimas = 0;
        if (qtdOps > 5) {
            inicioUltimas = qtdOps - 5;
        }

        double saldo = 0.0;
        for (int i = 0; i < inicioUltimas; i += 1) {

            saldo += vOpFiltrado[i].valor;
        }

        System.out.println("CONTA N." + vContas[posConta].id);

        System.out.println("CLIENTE: " + vContas[posConta].cliente);
        System.out.println("ID | OPERACAO | VALOR | SALDO");
        System.out.println("Saldo Anterior: " + formatarValorCD(saldo));

        for (int i = inicioUltimas; i < qtdOps; i += 1) {
            saldo += vOpFiltrado[i].valor;
            System.out.println(vOpFiltrado[i].id + " | "
                    + nomeOperacao(vOpFiltrado[i].tipo) + " | "
                    + formatarValorCD(vOpFiltrado[i].valor) + " | "
                    + formatarValorCD(saldo));
        }

        System.out.println("Saldo Atual: " + formatarValorCD(saldo));
    }

    public static Operacao criarOperacao(int id, int idConta, char tipo, double valor) {
        Operacao op = new Operacao();
        op.id = id;
        op.idConta = idConta;
        op.tipo = tipo;
        op.valor = valor;
        return op;
    }

    public static void main(String[] args) {
        Conta[] vContas = new Conta[TAM_CONTAS];
        Operacao[] vOp = new Operacao[TAM_OP];
        int tamConta = 0;
        int tamOp = 0;

        vContas[0] = new Conta();
        vContas[0].id = 1;
        vContas[0].cliente = "Maria Jose Santos";
        vContas[0].saldo = 424.99;
        vContas[0].limite = 1000.00;
        tamConta = 1;

        vOp[tamOp++] = criarOperacao(10, 1, 'D', 2437.55);
        vOp[tamOp++] = criarOperacao(25, 1, 'D', 1000.00);
        vOp[tamOp++] = criarOperacao(37, 1, 'D', 237.44);
        vOp[tamOp++] = criarOperacao(83, 1, 'T', -4000.00);
        vOp[tamOp++] = criarOperacao(95, 1, 'S', -250.00);
        vOp[tamOp++] = criarOperacao(112, 1, 'T', 1000.00);

        tamConta = cadastrarConta(vContas, tamConta);
        insertionSortCliente(vContas, tamConta);

        int pos = buscaBinariaCliente(vContas, tamConta, "Maria Jose Santos");
        System.out.println("Posicao: " +  pos);


        extrato(vContas, tamConta, vOp, tamOp);
    }
}
